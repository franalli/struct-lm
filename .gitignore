# Data: raw PDFs are re-fetched from data/sources.csv (url + sha256) by data/scripts/download.py
data/raw/*
!data/raw/.gitkeep
data/interim/
# processed corpus files are rebuilt by the scripts; stats.json (every count) and
# tokenizer_coverage.md are committed
data/processed/*
!data/processed/stats.json
!data/processed/tokenizer_coverage.md
data/packed/
# memorisation probe: post-cutoff PDFs (re-fetched from eval/exposure_sources.csv) and docs.jsonl
data/exposure/

# Training artifacts
checkpoints/
outputs/
wandb/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf

# Eval outputs: results/ is committed. runs/<run>/ (generations + scores),
# judge_cache.jsonl and lm_eval/ let anyone `run_eval.py --rescore --lm-eval-dir results/lm_eval`
# with no GPU or API key; bench/ holds the latency summaries. Smoke runs are throwaway.
results/runs/smoke/

# Python
__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Secrets (keep a template as .env.example)
.env
.env.*
!.env.example

# Local tooling
.remember/
.claude/settings.local.json
.DS_Store
.vscode/
.idea/
*.swp
*.log
nohup.out

# make_tasks LLM call cache
eval/.cache/
# SFT builder: its LLM call cache and the intermediate files between steps (data/sft/stats.json
# records every count; train.jsonl, sft_val.jsonl, sft_rejected.jsonl and review.md are committed)
data/sft/.cache/
data/sft/work/
