# Data: raw PDFs are re-fetched from data/sources.csv (url + sha256) by data/scripts/download.py
data/raw/*
!data/raw/.gitkeep
data/interim/
# processed corpus files are rebuilt by the scripts; stats.json (every count) and
# tokenizer_coverage.md are committed
data/processed/*
!data/processed/stats.json
!data/processed/tokenizer_coverage.md
# the CPT corpus files' hashes, checked against the Modal volume copies (2026-10-10)
!data/processed/SHA256SUMS
data/packed/
# memorisation probe: post-cutoff PDFs (re-fetched from eval/exposure_sources.csv) and docs.jsonl
data/exposure/

# Stage 6 bench request sets: rebuilt by serve/bench_data.py, pinned by serve/bench_manifest.json
serve/bench/

# Training artifacts
checkpoints/
outputs/
wandb/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf

# Eval outputs: results/ is committed. runs/<run>/ (generations + scores),
# judge_cache.jsonl and lm_eval/ let anyone `run_eval.py --rescore --lm-eval-dir results/lm_eval`
# with no GPU or API key; bench/ holds the latency summaries. Smoke runs are throwaway.
results/runs/smoke/
# eval/rescore_all.py's scratch rescore of every row
results/_rescore/

# Python
__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Secrets (keep a template as .env.example)
.env
.env.*
!.env.example

# Local tooling
.remember/
.claude/settings.local.json
.DS_Store
.vscode/
.idea/
*.swp
*.log
nohup.out

# make_tasks LLM call cache
eval/.cache/
# SFT builder: its LLM call cache and the intermediate files between steps (data/sft/stats.json
# records every count; sft_rejected.jsonl and review.md are committed). train.jsonl and
# sft_val.jsonl hold third-party Tülu 3 replay text, so git keeps data/sft/hosted/ (replay text
# blanked, row ids kept) and data/scripts/sft_replay_fetch.py rebuilds them against SHA256SUMS.
data/sft/train.jsonl
data/sft/sft_val.jsonl
# the probe prompts hold held-out Tülu 3 prompts: git keeps eval/hosted/, the same script rebuilds
eval/diversity_prompts.jsonl
eval/sft_template_prompts.jsonl
data/sft/.cache/
data/sft/work/

# Stage 4 scoring scratch (every pool sample with its scores; rebuilt by data/scripts/dpo_score.py)
data/dpo/work/
data/dpo/strict/work/

# demo recordings (masters live outside the repo)
video-work/
*.mov
*.mp4
# diagram PNGs are a local preview; git keeps the IR (docs/diagrams/src), .excalidraw and .svg
docs/diagrams/*.png
